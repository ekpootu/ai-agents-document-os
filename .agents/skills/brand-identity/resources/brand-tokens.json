{
  "brand": {
    "name": "Antigravity Document OS",
    "author": {
      "name": "Ekpo Otu, Ph.D.",
      "url": "https://linktr.ee/ekpootu",
      "github": "https://github.com/ekpootu",
      "buymeacoffee": "https://www.buymeacoffee.com/ekpootu"
    }
  },
  "colors": {
    "primary": "#1A3A8F",
    "primary_light": "#2450B8",
    "primary_dark": "#0D1B4C",
    "accent": "#FFC107",
    "accent_hover": "#FFD54F",
    "white": "#FFFFFF",
    "bg_light": "#F8F9FA",
    "bg_panel": "#F0F2F5",
    "border": "#DEE2E6",
    "muted": "#6B7280",
    "body": "#212529",
    "success": "#10B981",
    "danger": "#EF4444",
    "info": "#0EA5E9",
    "warning": "#F59E0B"
  },
  "gradients": {
    "hero": "linear-gradient(135deg, #1A3A8F 0%, #0D1B4C 100%)",
    "accent": "linear-gradient(135deg, #FFC107 0%, #FF9800 100%)",
    "card": "linear-gradient(180deg, #FFFFFF 0%, #F8F9FA 100%)"
  },
  "fonts": {
    "display": {
      "family": "Playfair Display",
      "weights": [700, 800],
      "fallback": "Georgia, 'Times New Roman', serif"
    },
    "body": {
      "family": "Source Sans 3",
      "weights": [400, 600, 700],
      "fallback": "'Helvetica Neue', Helvetica, Arial, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": [400, 500],
      "fallback": "'Fira Code', 'Cascadia Code', Consolas, monospace"
    },
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
  },
  "page_layout": {
    "trade_paperback": {
      "width": "6in",
      "height": "9in",
      "margins": {
        "top": "0.75in",
        "bottom": "0.75in",
        "outside": "0.625in",
        "gutter": "0.875in"
      }
    },
    "us_letter": {
      "width": "8.5in",
      "height": "11in",
      "margins": {
        "top": "0.75in",
        "bottom": "0.75in",
        "left": "0.75in",
        "right": "0.75in"
      }
    }
  },
  "typography_scale": {
    "document_title": { "font": "display", "size": "32pt", "weight": 800, "line_height": 1.2 },
    "chapter_title": { "font": "display", "size": "24pt", "weight": 700, "line_height": 1.25 },
    "section_heading": { "font": "body", "size": "16pt", "weight": 700, "line_height": 1.3 },
    "subsection": { "font": "body", "size": "13pt", "weight": 600, "line_height": 1.4 },
    "body_text": { "font": "body", "size": "11pt", "weight": 400, "line_height": 1.6 },
    "caption": { "font": "body", "size": "9pt", "weight": 400, "line_height": 1.4 },
    "code_block": { "font": "mono", "size": "9pt", "weight": 400, "line_height": 1.5 }
  },
  "web_tokens": {
    "radius": { "sm": "6px", "md": "12px", "lg": "20px", "xl": "28px" },
    "shadow": {
      "sm": "0 1px 3px rgba(13, 27, 76, 0.1)",
      "md": "0 4px 12px rgba(13, 27, 76, 0.12)",
      "lg": "0 10px 30px rgba(13, 27, 76, 0.15)",
      "glow": "0 0 25px rgba(26, 58, 143, 0.25)"
    }
  }
}
