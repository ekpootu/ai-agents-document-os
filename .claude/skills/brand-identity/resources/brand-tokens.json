{
  "brand": {
    "name": "AI Agents Document OS",
    "version": "5.0",
    "author": {
      "name": "Ekpo Otu, Ph.D.",
      "url": "https://linktr.ee/ekpootu",
      "github": "https://github.com/ekpootu",
      "buymeacoffee": "https://buymeacoffee.com/ekpootu"
    }
  },
  "colors": {
    "primary": "#033C45",
    "primary_light": "#065460",
    "primary_dark": "#06181B",
    "accent": "#C6A965",
    "accent_hover": "#D4BC82",
    "mint": "#D8ECE9",
    "canvas": "#F8F1E9",
    "white": "#FFFFFF",
    "bg_light": "#F8F1E9",
    "bg_panel": "#EFF7F6",
    "border": "#CBD5E1",
    "muted": "#64748B",
    "body": "#0F172A",
    "success": "#10B981",
    "danger": "#EF4444",
    "info": "#0284C7",
    "warning": "#F59E0B"
  },
  "gradients": {
    "hero": "linear-gradient(135deg, #033C45 0%, #06181B 100%)",
    "accent": "linear-gradient(135deg, #C6A965 0%, #B39247 100%)",
    "card": "linear-gradient(180deg, #FFFFFF 0%, #F8F1E9 100%)"
  },
  "fonts": {
    "display": {
      "family": "Playfair Display",
      "weights": [700, 800],
      "fallback": "Georgia, 'Times New Roman', serif"
    },
    "body": {
      "family": "Source Sans 3",
      "weights": [400, 600, 700],
      "fallback": "'Helvetica Neue', Helvetica, Arial, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": [400, 500],
      "fallback": "'Fira Code', 'Cascadia Code', Consolas, monospace"
    },
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
  },
  "page_layout": {
    "amazon_kdp_ratio": {
      "width": "6.0in",
      "height": "9.6in",
      "aspect_ratio": "1.6:1",
      "margins": {
        "top": "0.65in",
        "bottom": "0.65in",
        "outside": "0.55in",
        "gutter": "0.65in"
      }
    },
    "trade_paperback": {
      "width": "6.0in",
      "height": "9.0in",
      "margins": {
        "top": "0.75in",
        "bottom": "0.75in",
        "outside": "0.625in",
        "gutter": "0.875in"
      }
    },
    "us_letter": {
      "width": "8.5in",
      "height": "11.0in",
      "margins": {
        "top": "0.75in",
        "bottom": "0.75in",
        "left": "0.75in",
        "right": "0.75in"
      }
    }
  },
  "typography_scale": {
    "document_title": { "font": "display", "size": "30pt", "weight": 800, "line_height": 1.2 },
    "section_title": { "font": "display", "size": "20pt", "weight": 700, "line_height": 1.25 },
    "subheading": { "font": "body", "size": "14pt", "weight": 700, "line_height": 1.3 },
    "subsection": { "font": "body", "size": "12pt", "weight": 600, "line_height": 1.4 },
    "body_text": { "font": "body", "size": "10.5pt", "weight": 400, "line_height": 1.55 },
    "caption": { "font": "body", "size": "8.5pt", "weight": 400, "line_height": 1.4 },
    "code_block": { "font": "mono", "size": "8.5pt", "weight": 400, "line_height": 1.45 }
  },
  "web_tokens": {
    "radius": { "sm": "6px", "md": "12px", "lg": "20px", "xl": "28px" },
    "shadow": {
      "sm": "0 1px 3px rgba(3, 60, 69, 0.08)",
      "md": "0 4px 12px rgba(3, 60, 69, 0.12)",
      "lg": "0 10px 30px rgba(3, 60, 69, 0.16)",
      "glow": "0 0 25px rgba(198, 169, 101, 0.35)"
    }
  }
}
