# ============================================
# Antigravity Document OS — .gitignore
# ============================================

# Virtual Environment
.venv-docos/
.venv/
venv/
env/
.env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Environment & Secrets
.env
.env.local
.env.*.local
*.key
*.pem

# Downloaded Fonts Cache (regenerated automatically)
.agents/plugins/document-os/scripts/templates/fonts/

# OS-specific
ehthumbs.db
ehthumbs_vista.db

# Node (if applicable)
node_modules/
npm-debug.log*

# Temp & Ephemeral Renders (Workspace Bloat Prevention)
*.tmp
*.bak
previews/
scratch/pdf_renders/

# Antigravity Internal
.gemini/
.system_generated/

# Excluded User Deliverables & Working Folders
no-commit/

# Private Developer Management Skills (Super Developer use only)
.agents/skills/dashboard-design/
.agents/skills/github-repository-manager/
.agents/skills/web-design/
.claude/skills/dashboard-design/
.claude/skills/web-design/
github_setup.md

# Private Web Application & Admin CMS Suite
web/

# Private Design & Extracted Image Assets
extra/extracted_assets/

# Documentation & Assets
docs/*
!docs/AI_Agents_Document_OS_Comprehensive_Guide_v5.pdf

# Brand reference images (personal design source files)
brand-color*.png
brand-color*.jpeg
brand-color*.jpg
font-combo*.jpg
sample-page*.jpg
